# Security configuration (may contain sensitive access control info)
security/acl_storage.json

# IDE and editor files
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
